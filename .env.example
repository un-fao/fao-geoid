# ---------------------------------------------------------------------------
# GeoID configuration (environment-driven; pydantic-settings reads GEOID_*).
# Copy to .env and adjust. The core image imports no GCP SDK — everything here
# is portable between FAO GCP and an on-prem docker-compose deployment.
# ---------------------------------------------------------------------------

# Async SQLAlchemy URL (asyncpg driver). For docker-compose the host is `db`.
GEOID_DATABASE_URL=postgresql+asyncpg://geoid:geoid@localhost:5432/geoid

# Public base URL used to derive URI / OGC item links on read. Keep it the BARE origin:
# the "/geoid" segment in minted URIs comes from GEOID_ROOT_PATH (below), which is
# prepended to this value. Demo target: GEOID_BASE_URL=https://data.fao.org +
# GEOID_ROOT_PATH=/geoid  ->  https://data.fao.org/geoid/<uuid>
GEOID_BASE_URL=http://localhost:8000

# Sub-path the API is mounted under behind a reverse proxy (e.g. a Cloud HTTPS LB).
# Empty = served at root. Set to "/geoid" to expose the API at
# <BASE_URL>/geoid and Swagger at <BASE_URL>/geoid/docs. The prefix is also
# prepended to BASE_URL when minting URIs/links, so leave BASE_URL as the bare origin.
# The proxy must strip this prefix before forwarding to the app.
GEOID_ROOT_PATH=

# Deployment mode: "development" (default), "review", or "production". Outside
# development the service refuses to start with the default GEOID_ADMIN_TOKEN below,
# so a missing secret mount can never leave the dev token live in production.
GEOID_ENVIRONMENT=development

# Static admin bearer token gating create/manage/list (temporary stopgap auth).
# Delegates to the FAO unified auth service once available (see the seam below).
# CHANGE THIS — do not ship the default (rejected at startup when ENVIRONMENT != development).
GEOID_ADMIN_TOKEN=change-me-dev-only

# Reserved collection slug that accepts anonymous writes (writable_anon=true).
GEOID_PUBLIC_COLLECTION=public

# This instance's id, stamped into provenance + place.originating_instance
# (federation seam). Central = "fao-central"; a country = e.g. "ke-nairobi".
GEOID_INSTANCE_ID=fao-central

# Synchronous bulk write. Hard cap on features per bulk POST FeatureCollection; a
# write bound MUST error (413), never silently truncate — exceeding it rejects the
# whole request.
GEOID_BULK_MAX_FEATURES=1000

# Geometry dedup coordinate precision: the ST_ReducePrecision grid size in decimal
# degrees per vertex. 1e-7 ≈ 1cm — exact-match semantics (absorbs float jitter
# only; it does NOT merge nearby shapes), per the team's final ruling. ONE global
# grid (geometry uniqueness is catalog-wide; duplicate POST → 409 + incumbent
# geoid). Effectively migration-pinned: it MUST equal the BEFORE-INSERT trigger's
# literal (migration 0001) or the conflict lookup misses — retune via a migration,
# never by editing this value alone.
# GEOID_DEDUP_GRID_DEFAULT=1e-7

# --- Unified auth service seam (Release-1 stretch goal; Eduardo's team, expected to
# be OIDC — confirm before wiring). Inert while GEOID_ADMIN_TOKEN is set; the oidc_*
# names are kept deliberately to avoid a second rename later. ---
# GEOID_OIDC_ISSUER=https://idp.fao.org/realms/geoid
# GEOID_OIDC_JWKS_URL=https://idp.fao.org/realms/geoid/protocol/openid-connect/certs
# GEOID_OIDC_AUDIENCE=geoid-api
