# ---------------------------------------------------------------------------
# GeoID configuration (environment-driven; pydantic-settings reads GEOID_*).
# Copy to .env and adjust. The core image imports no GCP SDK — everything here
# is portable between FAO GCP and an on-prem docker-compose deployment.
# ---------------------------------------------------------------------------

# Async SQLAlchemy URL (asyncpg driver). For docker-compose the host is `db`.
GEOID_DATABASE_URL=postgresql+asyncpg://geoid:geoid@localhost:5432/geoid

# Public base URL used to derive URI / OGC item links on read.
# Demo target: https://data.fao.org  -> https://data.fao.org/geoid/<uuid>
GEOID_BASE_URL=http://localhost:8000

# Sub-path the API is mounted under behind a reverse proxy (e.g. a Cloud HTTPS LB).
# Empty = served at root. Set to "/geoid/v1" to expose the API at
# <BASE_URL>/geoid/v1 and Swagger at <BASE_URL>/geoid/v1/docs. The prefix is also
# prepended to BASE_URL when minting URIs/links, so leave BASE_URL as the bare origin.
# The proxy must strip this prefix before forwarding to the app.
GEOID_ROOT_PATH=

# Deployment mode: "development" (default), "review", or "production". Outside
# development the service refuses to start with the default GEOID_ADMIN_TOKEN below,
# so a missing secret mount can never leave the dev token live in production.
GEOID_ENVIRONMENT=development

# Static admin bearer token gating create/manage/list (temporary stopgap auth).
# Delegates to the FAO unified auth service once available (see the seam below).
# CHANGE THIS — do not ship the default (rejected at startup when ENVIRONMENT != development).
GEOID_ADMIN_TOKEN=change-me-dev-only

# Reserved collection slug that accepts anonymous writes (writable_anon=true).
GEOID_PUBLIC_COLLECTION=public

# This instance's id, stamped into provenance + place.originating_instance
# (federation seam). Central = "fao-central"; a country = e.g. "ke-nairobi".
GEOID_INSTANCE_ID=fao-central

# API vocabulary surfaced at the edge: "stac" (default — the OGC/STAC-aligned
# terms catalog/collection/item), "fao" (workspace/collection/item), or
# "neutral". A config flip, not a migration.
GEOID_VOCAB=stac

# Object storage backend: "local" (on-prem default) or "gcs" (FAO GCP).
GEOID_STORAGE_BACKEND=local
GEOID_STORAGE_LOCAL_ROOT=./_blobstore
# GEOID_STORAGE_GCS_BUCKET=fao-geoid-blobs

# Bulk ingest (milestone 1.3). Hard cap on features per bulk-ingest request; a
# write bound MUST error (413), never silently truncate — exceeding it rejects the
# whole FeatureCollection.
GEOID_BULK_MAX_FEATURES=10000

# Async worker chunk size: features per transaction (unit-of-retry = unit-of-
# atomicity). The drain limit bounds how many jobs one worker invocation claims.
GEOID_INGEST_CHUNK_SIZE=2000
GEOID_INGEST_DRAIN_LIMIT=100

# Cloud Run Job the web service triggers (jobs.run) to drain the async queue. All
# optional: unset (on-prem / dev) -> the trigger is a no-op and the queue is drained
# by the Cloud Scheduler fallback or a manual `geoid ingest-worker` run.
# GEOID_INGEST_JOB_NAME=geoid-ingest-worker
# GEOID_INGEST_JOB_REGION=europe-west1
# GEOID_INGEST_JOB_PROJECT=fao-geoid

# bulk-export download URL TTL (seconds). A GCS V4 signed URL maxes out at 7 days
# (604800); the local backend ignores it and returns a stable file URI.
GEOID_EXPORT_SIGNED_URL_TTL_SECONDS=604800

# Async completion notification (Notifier seam). "none" (default) ships the feature
# without the org dependency — pull-polling GET /jobs/{id} is always the contract.
# "graph" emails via MS Graph sendMail (app-only OAuth, HTTPS/443) — needs an Entra
# app registration with Mail.Send admin consent + a sender mailbox. Set these only on
# the WORKER (the web service never carries the Graph secret).
GEOID_NOTIFY_BACKEND=none
# GEOID_GRAPH_TENANT_ID=
# GEOID_GRAPH_CLIENT_ID=
# GEOID_GRAPH_CLIENT_SECRET=   # from Secret Manager (worker-only), never committed
# GEOID_GRAPH_SENDER=geoid-noreply@fao.org
# GEOID_GRAPH_SUPPRESS_SEND=false   # build the message but skip the HTTP send (dry-run)

# Read paging guard rails. max_offset bounds OFFSET paging on the items and
# item-ids endpoints (a deep OFFSET makes the DB scan and discard that many rows
# per request); rel=next links stop at the cap, so 0 cleanly disables deep paging.
GEOID_DEFAULT_LIMIT=100
GEOID_MAX_LIMIT=10000
GEOID_MAX_OFFSET=100000

# Geometry dedup coordinate precision: the ST_ReducePrecision grid size in decimal
# degrees per vertex. 1e-7 ≈ 1cm — exact-match semantics (absorbs float jitter
# only; it does NOT merge nearby shapes), per the team's final ruling. ONE global
# grid (geometry uniqueness is catalog-wide; duplicate POST → 409 + incumbent
# geoid). Effectively migration-pinned: it MUST equal the BEFORE-INSERT trigger's
# literal (migration 0001) or the conflict lookup misses — retune via a migration,
# never by editing this value alone.
# GEOID_DEDUP_GRID_DEFAULT=1e-7

# --- Unified auth service seam (expected to be OIDC). Inert while GEOID_ADMIN_TOKEN is set; the oidc_*
# names are kept deliberately to avoid a second rename later. ---
# GEOID_OIDC_ISSUER=https://idp.fao.org/realms/geoid
# GEOID_OIDC_JWKS_URL=https://idp.fao.org/realms/geoid/protocol/openid-connect/certs
# GEOID_OIDC_AUDIENCE=geoid-api
